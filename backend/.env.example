# Supabase PostgreSQL (Transaction-mode pooler for runtime)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<YOUR-PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase PostgreSQL (Session-mode pooler for migrations & data loading)
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<YOUR-PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Optional production overrides
# DJANGO_SECRET_KEY=replace-with-strong-secret
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-backend.example.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional external LLM (if unset, HosiKe AI uses the built-in fuzzy-NLP live DB engine)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434/api/chat
